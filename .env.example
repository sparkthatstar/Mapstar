# Environment variables template for Mapstar

# Database configuration (SQLite for local sandbox, Supabase PostgreSQL for prod)
DATABASE_URL="file:./dev.db"

# Admin Account Credentials (configure in your secret .env.local file)
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_this_password"
ADMIN_SESSION_SECRET="generate_a_secure_random_session_secret"
USER_SESSION_SECRET="generate_a_secure_random_user_session_secret"
