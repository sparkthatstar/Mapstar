# =====================================================================
# Mapstar Environment Configuration — Supabase Production & Local Setup
# =====================================================================

# ---------------------------------------------------------------------
# 1. Supabase PostgreSQL Database (Prisma ORM)
# ---------------------------------------------------------------------
# Supabase Dashboard → Settings → Database → Connection string:
# 
# DATABASE_URL (Transaction Pooler - port 6543):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL (Session Mode / Direct - port 5432, used for migrations & schema push):
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------------
# 2. Supabase Client Keys (Storage & Client SDK)
# ---------------------------------------------------------------------
# Supabase Dashboard → Settings → API:
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ---------------------------------------------------------------------
# 3. Administrator Credentials
# ---------------------------------------------------------------------
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="YourSecureAdminPassword123!"
ADMIN_SESSION_SECRET="generate-a-random-32-character-secret-key-here"
USER_SESSION_SECRET="generate-another-random-32-char-secret-key-here"

# ---------------------------------------------------------------------
# 4. Maps & External Integrations (Optional)
# ---------------------------------------------------------------------
# NEXT_PUBLIC_MAPBOX_TOKEN=""
# PAYSTACK_SECRET_KEY=""
# FLUTTERWAVE_SECRET_KEY=""

# ---------------------------------------------------------------------
# 5. Persona Identity Verification API (Identity Verification)
# ---------------------------------------------------------------------
# Persona Dashboard → API Keys:
PERSONA_API_KEY="persona_production_or_sandbox_api_key"
PERSONA_TEMPLATE_ID="itmpl_your_inquiry_template_id"
NEXT_PUBLIC_PERSONA_TEMPLATE_ID="itmpl_your_inquiry_template_id"
NEXT_PUBLIC_PERSONA_ENVIRONMENT_ID="env_your_environment_id"
